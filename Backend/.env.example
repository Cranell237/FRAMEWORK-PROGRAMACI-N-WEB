# Configuracion local de PostgreSQL (solo desarrollo)
POSTGRES_USER=multicatalogo
POSTGRES_PASSWORD=multicatalogo_dev_local
POSTGRES_DB=multicatalogo
POSTGRES_PORT=5432

# Conexion que utilizara la API Go en los siguientes modulos
DB_HOST=localhost
DB_SSLMODE=disable

# Conexion local de Redis (cache de la Fase 3)
REDIS_URL=redis://localhost:6379/0
REDIS_PORT=6379
